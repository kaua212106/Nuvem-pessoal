{
  "name": "Cofre JSON - Nuvem pessoal",
  "short_name": "Nuvem",
  "description": "Sua nuvem pessoal de arquivos JSON, armazenados no GitHub.",
  "lang": "pt-BR",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#12303a",
  "theme_color": "#12303a",
  "categories": [
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "icon.png",
      "sizes": "192x192 512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon.png",
      "sizes": "192x192 512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "arquivos",
          "accept": [
            "*/*"
          ]
        }
      ]
    }
  }
}
